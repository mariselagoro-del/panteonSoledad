# ==============================================================================
# Panteón La Soledad - Variables de Entorno
# ==============================================================================

# 1. Conexión en la Nube (Render, Neon, Supabase, Railway)
# Al configurar esta variable, el sistema la detecta automáticamente y activa SSL.
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_base_datos

# 2. Conexión Local en Desarrollo (PostgreSQL en tu máquina)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=PanteonLaSoledad

# 3. Puerto del Servidor Backend (Render y otros proveedores asignan PORT automáticamente)
PORT=5000

# 4. URL de la API para el Frontend (Opcional)
# Si se deja vacío, el frontend utilizará la ruta relativa "/api" (recomendado para 'Todo en Uno')
# VITE_API_URL=
